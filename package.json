{
  "name": "wezy-claude",
  "productName": "Wezy",
  "version": "0.1.1",
  "description": "A desktop workspace for Claude Code and Codex with persistent terminals and local session management.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.wezy.claude",
    "productName": "Wezy",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "defaultArch": "arm64"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "artifactName": "Wezy-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "license": "MIT",
  "author": "Wezy contributors",
  "homepage": "https://github.com/huzhongyyuan/Wezy",
  "repository": {
    "type": "git",
    "url": "https://github.com/huzhongyyuan/Wezy.git"
  }
}
